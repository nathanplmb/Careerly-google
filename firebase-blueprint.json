{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Rôle administrateur sécurisé de la plateforme NACORA",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "creeLe": { "type": "string" }
      },
      "required": ["user_id", "email"]
    },
    "Profil": {
      "title": "Profil",
      "description": "Profil professionnel du candidat",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "email": { "type": "string" },
        "prenom": { "type": "string" },
        "nom": { "type": "string" },
        "titre": { "type": "string" },
        "provider": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["user_id"]
    },
    "Candidature": {
      "title": "Candidature",
      "description": "Suivi d'une candidature",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "entreprise": { "type": "string" },
        "poste": { "type": "string" },
        "statut": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["user_id", "entreprise", "poste"]
    },
    "Contact": {
      "title": "Contact",
      "description": "Contact réseau du candidat",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "nom": { "type": "string" },
        "entreprise": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["user_id", "nom"]
    },
    "Entreprise": {
      "title": "Entreprise",
      "description": "Entreprise cible liée aux opportunités et contacts",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "nom": { "type": "string" },
        "normalizedName": { "type": "string" },
        "secteur": { "type": "string" },
        "siteWeb": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["user_id", "nom"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Enregistrement des administrateurs autorisés"
    },
    "/profils/{userId}": {
      "schema": { "$ref": "#/entities/Profil" },
      "description": "Profil individuel par utilisateur"
    },
    "/users/{userId}/candidatures/{candidatureId}": {
      "schema": { "$ref": "#/entities/Candidature" },
      "description": "Candidatures appartenant à un utilisateur"
    },
    "/users/{userId}/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/Contact" },
      "description": "Contacts réseau appartenant à un utilisateur"
    },
    "/users/{userId}/entreprises/{entrepriseId}": {
      "schema": { "$ref": "#/entities/Entreprise" },
      "description": "Entreprises appartenant à un utilisateur"
    }
  }
}
